<?xml version=1.0 encoding=utf-8?>
<LinearLayout xmlns:android=http://schemas.android.com/apk/res/android
    android:layout_width=match_parent
    android:layout_height=match_parent
    android:orientation=vertical
    android:background=@color/bg_dark>

    <LinearLayout
        android:layout_width=match_parent
        android:layout_height=56dp
        android:orientation=horizontal
        android:gravity=center_vertical
        android:paddingHorizontal=12dp
        android:background=@color/bg_surface>

        <ImageView
            android:id=@+id/btnBackSubtitle
            android:layout_width=40dp
            android:layout_height=40dp
            android:padding=8dp
            android:src=@drawable/ic_arrow_back
            android:background=?attr/selectableItemBackgroundBorderless />

        <TextView
            android:layout_width=wrap_content
            android:layout_height=wrap_content
            android:layout_marginStart=12dp
            android:text=Subtitle
            android:textColor=@color/text_primary
            android:textSize=18sp
            android:textStyle=bold />
    </LinearLayout>

    <ScrollView
        android:layout_width=match_parent
        android:layout_height=match_parent>

        <LinearLayout
            android:layout_width=match_parent
            android:layout_height=wrap_content
            android:orientation=vertical
            android:padding=16dp>

            <TextView
                android:layout_width=wrap_content
                android:layout_height=wrap_content
                android:text=Character Encoding
                android:textColor=@color/icon_blue
                android:textSize=13sp
                android:textStyle=bold
                android:layout_marginBottom=16dp />

            <!-- Subtitle Character Encoding Picker -->
            <LinearLayout
                android:id=@+id/layoutSubtitleEncoding
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:orientation=vertical
                android:clickable=true
                android:focusable=true
                android:paddingVertical=8dp
                android:layout_marginBottom=16dp>

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:text=Character encoding
                    android:textColor=@color/text_primary
                    android:textSize=14sp />

                <TextView
                    android:id=@+id/tvSubtitleEncodingVal
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:layout_marginTop=2dp
                    android:text=UTF-8 (Default)
                    android:textColor=@color/text_secondary
                    android:textSize=12sp />
            </LinearLayout>

            <View
                android:layout_width=match_parent
                android:layout_height=1dp
                android:background=@color/divider_color
                android:layout_marginBottom=16dp />

            <TextView
                android:layout_width=wrap_content
                android:layout_height=wrap_content
                android:text=Appearance &amp; Text
                android:textColor=@color/icon_blue
                android:textSize=13sp
                android:textStyle=bold
                android:layout_marginBottom=16dp />

            <LinearLayout
                android:id=@+id/layoutSubtitleSize
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:orientation=vertical
                android:clickable=true
                android:focusable=true
                android:paddingVertical=8dp
                android:layout_marginBottom=16dp>

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:text=Text size
                    android:textColor=@color/text_primary
                    android:textSize=14sp />

                <TextView
                    android:id=@+id/tvSubtitleSizeVal
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:layout_marginTop=2dp
                    android:text=Medium (24 sp)
                    android:textColor=@color/text_secondary
                    android:textSize=12sp />
            </LinearLayout>

            <LinearLayout
                android:id=@+id/layoutSubtitleColor
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:orientation=vertical
                android:clickable=true
                android:focusable=true
                android:paddingVertical=8dp>

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:text=Text color
                    android:textColor=@color/text_primary
                    android:textSize=14sp />

                <TextView
                    android:id=@+id/tvSubtitleColorVal
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:layout_marginTop=2dp
                    android:text=White with black border
                    android:textColor=@color/text_secondary
                    android:textSize=12sp />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>