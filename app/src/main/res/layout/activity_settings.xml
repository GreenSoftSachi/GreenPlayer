<?xml version=1.0 encoding=utf-8?>
<LinearLayout xmlns:android=http://schemas.android.com/apk/res/android
    xmlns:app=http://schemas.android.com/apk/res-auto
    android:layout_width=match_parent
    android:layout_height=match_parent
    android:orientation=vertical
    android:background=@color/bg_dark>

    <LinearLayout
        android:layout_width=match_parent
        android:layout_height=56dp
        android:orientation=horizontal
        android:gravity=center_vertical
        android:paddingHorizontal=12dp
        android:background=@color/bg_surface>

        <ImageView
            android:id=@+id/btnBackMainSettings
            android:layout_width=40dp
            android:layout_height=40dp
            android:padding=8dp
            android:src=@drawable/ic_arrow_back
            android:background=?attr/selectableItemBackgroundBorderless />

        <TextView
            android:layout_width=wrap_content
            android:layout_height=wrap_content
            android:layout_marginStart=12dp
            android:text=Settings
            android:textColor=@color/text_primary
            android:textSize=18sp
            android:textStyle=bold />
    </LinearLayout>

    <ScrollView
        android:layout_width=match_parent
        android:layout_height=match_parent>

        <LinearLayout
            android:layout_width=match_parent
            android:layout_height=wrap_content
            android:orientation=vertical
            android:padding=16dp>

            <!-- 1. List -->
            <LinearLayout
                android:id=@+id/menuSettingList
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_list
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=List
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Appearance and scan settings
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 2. Player -->
            <LinearLayout
                android:id=@+id/menuSettingPlayer
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_sort_status
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Player
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Playback, seeking, controls and gestures
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 3. Decoder -->
            <LinearLayout
                android:id=@+id/menuSettingDecoder
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_sort_hd
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Decoder
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Hardware acceleration (HW+) and custom codec
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 4. Audio -->
            <LinearLayout
                android:id=@+id/menuSettingAudio
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_music
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Audio
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Volume boost (200%), sync and equalizer
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 5. Subtitle -->
            <LinearLayout
                android:id=@+id/menuSettingSubtitle
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_sort_title
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Subtitle
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Character encodings, size, color and styling
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 6. General -->
            <LinearLayout
                android:id=@+id/menuSettingGeneral
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:background=?attr/selectableItemBackground
                android:clickable=true
                android:focusable=true>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_settings
                    android:tint=@color/icon_blue />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=General
                        android:textColor=@color/text_primary
                        android:textSize=15sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Language, clear history, clear cache
                        android:textColor=@color/text_secondary
                        android:textSize=12sp />
                </LinearLayout>

                <ImageView
                    android:layout_width=20dp
                    android:layout_height=20dp
                    android:src=@drawable/ic_chevron_right
                    android:tint=@color/text_hint />
            </LinearLayout>

            <View android:layout_width=match_parent android:layout_height=1dp android:background=@color/divider_color />

            <!-- 7. About -->
            <LinearLayout
                android:layout_width=match_parent
                android:layout_height=60dp
                android:orientation=horizontal
                android:gravity=center_vertical
                android:paddingVertical=8dp>

                <ImageView
                    android:layout_width=26dp
                    android:layout_height=26dp
                    android:src=@drawable/ic_privacy
                    android:tint=@color/green_primary />

                <LinearLayout
                    android:layout_width=0dp
                    android:layout_height=wrap_content
                    android:layout_weight=1
                    android:layout_marginStart=16dp
                    android:orientation=vertical>

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Green Player v1.0.0
                        android:textColor=@color/text_primary
                        android:textSize=14sp
                        android:textStyle=bold />

                    <TextView
                        android:layout_width=wrap_content
                        android:layout_height=wrap_content
                        android:text=Created by GreenSoft
                        android:textColor=@color/green_accent
                        android:textSize=11sp />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>