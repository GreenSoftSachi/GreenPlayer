<?xml version=1.0 encoding=utf-8?>
<LinearLayout xmlns:android=http://schemas.android.com/apk/res/android
    xmlns:app=http://schemas.android.com/apk/res-auto
    android:layout_width=match_parent
    android:layout_height=match_parent
    android:orientation=vertical
    android:background=@color/bg_dark>

    <!-- Top Action Bar -->
    <LinearLayout
        android:id=@+id/mainTopBar
        android:layout_width=match_parent
        android:layout_height=56dp
        android:orientation=horizontal
        android:gravity=center_vertical
        android:paddingHorizontal=16dp
        android:background=@color/bg_surface>

        <ImageView
            android:layout_width=28dp
            android:layout_height=28dp
            android:src=@mipmap/ic_launcher
            android:layout_marginEnd=12dp />

        <TextView
            android:id=@+id/tvMainTitle
            android:layout_width=0dp
            android:layout_height=wrap_content
            android:layout_weight=1
            android:text=Folders
            android:textColor=@color/text_primary
            android:textSize=20sp
            android:textStyle=bold />

        <!-- Button 1: Toggle View Mode (All folders / Files / Folders) -->
        <ImageButton
            android:id=@+id/btnToggleViewMode
            android:layout_width=40dp
            android:layout_height=40dp
            android:background=?attr/selectableItemBackgroundBorderless
            android:src=@drawable/ic_all_folders
            android:tint=@color/icon_tint />

        <!-- Button 2: Search -->
        <ImageButton
            android:id=@+id/btnSearch
            android:layout_width=40dp
            android:layout_height=40dp
            android:background=?attr/selectableItemBackgroundBorderless
            android:src=@drawable/ic_search
            android:tint=@color/icon_tint />

        <!-- Button 3: View Mode & Sort Dialog -->
        <ImageButton
            android:id=@+id/btnViewSortDialog
            android:layout_width=40dp
            android:layout_height=40dp
            android:background=?attr/selectableItemBackgroundBorderless
            android:src=@drawable/ic_grid
            android:tint=@color/icon_tint />

    </LinearLayout>

    <!-- Collapsible Search Input -->
    <EditText
        android:id=@+id/etSearch
        android:layout_width=match_parent
        android:layout_height=42dp
        android:layout_marginHorizontal=16dp
        android:layout_marginVertical=6dp
        android:background=@drawable/bg_hud_overlay
        android:hint=@string/search_hint
        android:textColorHint=@color/text_hint
        android:textColor=@color/text_primary
        android:paddingHorizontal=14dp
        android:textSize=13sp
        android:visibility=gone />

    <!-- Main ViewPager2 Container (Local, Music, Transfer, Me) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id=@+id/mainViewPager
        android:layout_width=match_parent
        android:layout_height=0dp
        android:layout_weight=1 />

    <!-- Bottom Navigation Bar (4 tabs) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id=@+id/mainBottomNav
        android:layout_width=match_parent
        android:layout_height=56dp
        android:background=@color/bg_surface
        app:menu=@menu/bottom_nav_menu
        app:itemIconTint=@color/icon_tint_active
        app:itemTextColor=@color/icon_tint_active
        app:labelVisibilityMode=labeled
        app:elevation=8dp />

</LinearLayout>