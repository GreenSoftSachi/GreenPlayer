<?xml version=1.0 encoding=utf-8?>
<LinearLayout xmlns:android=http://schemas.android.com/apk/res/android
    android:layout_width=match_parent
    android:layout_height=match_parent
    android:orientation=vertical
    android:background=@color/bg_dark>

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width=match_parent
        android:layout_height=56dp
        android:orientation=horizontal
        android:gravity=center_vertical
        android:paddingHorizontal=12dp
        android:background=@color/bg_surface>

        <ImageView
            android:id=@+id/btnBackListSettings
            android:layout_width=40dp
            android:layout_height=40dp
            android:padding=8dp
            android:src=@drawable/ic_arrow_back
            android:background=?attr/selectableItemBackgroundBorderless />

        <TextView
            android:layout_width=wrap_content
            android:layout_height=wrap_content
            android:layout_marginStart=12dp
            android:text=List
            android:textColor=@color/text_primary
            android:textSize=18sp
            android:textStyle=bold />
    </LinearLayout>

    <ScrollView
        android:layout_width=match_parent
        android:layout_height=match_parent>

        <LinearLayout
            android:layout_width=match_parent
            android:layout_height=wrap_content
            android:orientation=vertical
            android:padding=16dp>

            <!-- Appearance Section -->
            <TextView
                android:layout_width=wrap_content
                android:layout_height=wrap_content
                android:text=Appearance
                android:textColor=@color/icon_blue
                android:textSize=13sp
                android:textStyle=bold
                android:layout_marginBottom=16dp />

            <!-- 1. Last media in each folder -->
            <CheckBox
                android:id=@+id/cbLastMedia
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:text=Last media in each folder\nMark last played media in each folder.
                android:textColor=@color/text_primary
                android:textSize=13sp
                android:lineSpacingExtra=3dp
                android:checked=true
                android:layout_marginBottom=16dp />

            <!-- 2. Scroll down to last media -->
            <CheckBox
                android:id=@+id/cbScrollLastMedia
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:text=Scroll down to last media\nAuto-scroll to position of the last played media.
                android:textColor=@color/text_primary
                android:textSize=13sp
                android:lineSpacingExtra=3dp
                android:layout_marginBottom=16dp />

            <!-- 3. Select thumbnail -->
            <CheckBox
                android:id=@+id/cbSelectThumbnail
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:text=Select thumbnail\nSwitch to selection mode by touching the thumbnail or icon.
                android:textColor=@color/text_primary
                android:textSize=13sp
                android:lineSpacingExtra=3dp
                android:layout_marginBottom=16dp />

            <!-- 4. Floating button -->
            <CheckBox
                android:id=@+id/cbFloatingButton
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:text=Floating button\nPlace a floating button on the bottom right corner of the screen to start last played media.
                android:textColor=@color/text_primary
                android:textSize=13sp
                android:lineSpacingExtra=3dp
                android:checked=true
                android:layout_marginBottom=16dp />

            <!-- 5. Show local playback history -->
            <CheckBox
                android:id=@+id/cbShowHistory
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:text=Show local playback history\nDisplay recent local playback history on the home page.
                android:textColor=@color/text_primary
                android:textSize=13sp
                android:lineSpacingExtra=3dp
                android:checked=true
                android:layout_marginBottom=16dp />

            <!-- 6. Period tagged as NEW -->
            <LinearLayout
                android:id=@+id/layoutPeriodNew
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:orientation=vertical
                android:clickable=true
                android:focusable=true
                android:paddingVertical=8dp
                android:layout_marginBottom=24dp>

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:text=Period tagged as &quot;NEW&quot;
                    android:textColor=@color/text_primary
                    android:textSize=14sp />

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:layout_marginTop=2dp
                    android:text=&quot;NEW&quot; tag will be displayed if the file was modified within this period.
                    android:textColor=@color/text_secondary
                    android:textSize=12sp />
            </LinearLayout>

            <View
                android:layout_width=match_parent
                android:layout_height=1dp
                android:background=@color/divider_color
                android:layout_marginBottom=16dp />

            <!-- Scan Section -->
            <TextView
                android:layout_width=wrap_content
                android:layout_height=wrap_content
                android:text=Scan
                android:textColor=@color/icon_blue
                android:textSize=13sp
                android:textStyle=bold
                android:layout_marginBottom=16dp />

            <!-- Folders -->
            <LinearLayout
                android:id=@+id/layoutScanFolders
                android:layout_width=match_parent
                android:layout_height=wrap_content
                android:orientation=vertical
                android:clickable=true
                android:focusable=true
                android:paddingVertical=8dp>

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:text=Folders
                    android:textColor=@color/text_primary
                    android:textSize=14sp />

                <TextView
                    android:layout_width=wrap_content
                    android:layout_height=wrap_content
                    android:layout_marginTop=2dp
                    android:text=Select folders to be included in the media library.
                    android:textColor=@color/text_secondary
                    android:textSize=12sp />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>