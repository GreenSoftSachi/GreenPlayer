<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. View Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Mode"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/btnViewAllFolders"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📁 All folders"
                android:textColor="@color/green_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_hud_overlay"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnViewFiles"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📄 Files"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_hud_overlay"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnViewFolders"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📂 Folders"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_hud_overlay" />

        </LinearLayout>

        <!-- 2. Layout Mode (List vs Grid) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Layout"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/btnLayoutList"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☰ List"
                android:textColor="@color/green_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_hud_overlay"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btnLayoutGrid"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⊞ Grid"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_hud_overlay" />

        </LinearLayout>

        <!-- 3. Sort Options -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/sortTitle"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/sortDate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="@color/green_primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/sortSize"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/sortLength"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Length"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/sortResolution"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolution"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/sortPlayedTime"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Played Time"
                android:textColor="@color/text_secondary" />

        </GridLayout>

        <!-- Cancel / Done Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelSort"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnDoneSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/green_primary"
                android:text="Done"
                android:textColor="#000000"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
