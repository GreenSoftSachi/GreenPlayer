<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playback_speed"
        android:textColor="@color/green_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCurrentSpeedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.00x (Normal)"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp" />

    <SeekBar
        android:id="@+id/sbSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="15"
        android:progress="3"
        android:progressTint="@color/green_primary"
        android:thumbTint="@color/green_neon"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnResetSpeed"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset (1.0x)"
            android:textColor="@color/green_accent" />

        <Button
            android:id="@+id/btnDoneSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/green_primary"
            android:text="Apply"
            android:textColor="#000000"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
